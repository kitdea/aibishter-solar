# Sanity CMS — get these from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Contact form — Google Apps Script web app URL
GOOGLE_APPS_SCRIPT_URL=

# Contact form — email to receive notification copies
CONTACT_NOTIFY_EMAIL=

# Sanity ISR webhook secret — set same value in Sanity webhook config
SANITY_REVALIDATE_SECRET=
